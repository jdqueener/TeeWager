{
  "expo": {
    "name": "TeeWager",
    "slug": "TeeWager",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "scheme": "teewager",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.teewager.app",
      "buildNumber": "7",
      "infoPlist": {
        "NSCameraUsageDescription": "TeeWager uses your camera to scan QR codes at partner courses.",
        "NSPhotoLibraryUsageDescription": "TeeWager saves your round results to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.teewager.app",
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundColor": "#14432A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "TeeWager",
      "shortName": "TeeWager",
      "description": "Golf wagering made easy. Track beans, settle up, share results.",
      "lang": "en",
      "themeColor": "#1A4A2E",
      "backgroundColor": "#F0F4F0",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/",
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "TeeWager uses your photos to scan golf scorecards.",
          "cameraPermission": "TeeWager uses your camera to scan golf scorecards."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "284e43de-e5b4-45a9-9ed3-320728a64f76"
      }
    },
    "owner": "teewager-llc"
  }
}
